<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>✨ 성실한 삶 인터뷰 역할극 생성기</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <!-- Google Fonts: Gaegu (for fun titles) & Noto Sans KR (for readability) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Noto+Sans+KR:wght@400;600;800;900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Noto Sans KR', sans-serif;
            /* Soft, warm gradient for a moral/growth theme */
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            background-image: linear-gradient(120deg, #d4fc79 0%, #96e6a1 100%);
            min-height: 100vh;
        }
        .font-gaegu {
            font-family: 'Gaegu', cursive;
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.4);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #4ade80;
            border-radius: 10px;
        }
        
        /* Print Styles */
        @media print {
            body {
                background: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            .script-card-print {
                box-shadow: none !important;
                border: 2px solid #000 !important;
                margin-bottom: 2rem !important;
                page-break-inside: avoid;
            }
            /* Force background colors to print */
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
        
        .btn-bounce {
            transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .btn-bounce:hover {
            transform: translateY(-3px) scale(1.02);
        }
        .btn-bounce:active {
            transform: translateY(2px) scale(0.98);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            border: 3px solid rgba(255, 255, 255, 0.8);
        }
        
        /* Custom Checkbox Styles */
        .checkbox-custom:checked + div {
            border-color: #10b981;
            background-color: #ecfdf5;
        }
        .checkbox-custom:checked + div .check-icon {
            opacity: 1;
            transform: scale(1);
        }
        .radio-custom:checked + div {
            border-color: #3b82f6;
            background-color: #eff6ff;
            box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2);
        }
    </style>
</head>
<body class="p-3 sm:p-6 text-slate-800 antialiased selection:bg-green-200">

    <div class="max-w-4xl mx-auto min-h-[90vh] flex flex-col justify-between">
        
        <!-- Header Section -->
        <header class="no-print text-center my-3 sm:my-5">
            <div class="inline-block bg-white/95 px-6 py-3 sm:py-4 rounded-3xl shadow-xl border-4 border-green-400 transform -rotate-1 mb-2">
                <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight flex items-center justify-center gap-2">
                    <span class="animate-bounce text-green-500">🌱</span>
                    <span class="font-gaegu text-3xl sm:text-5xl md:text-6xl text-emerald-600 drop-shadow-sm">성실한 삶</span>
                    <span class="text-slate-700">인터뷰 역할극</span>
                    <span class="animate-pulse text-amber-400">🎤</span>
                </h1>
            </div>
            <p class="text-slate-700 font-extrabold text-sm sm:text-base mt-1 bg-white/80 inline-block px-5 py-1.5 rounded-full shadow-sm border border-white">
                💡 초3 도덕: 끈기 있게 노력하는 성실한 사람들의 이야기를 들어보아요!
            </p>
        </header>

        <main class="flex-grow flex flex-col justify-center my-2">

            <!-- STEP 0: Welcome Screen -->
            <section id="step-0" class="glass-card rounded-3xl p-6 sm:p-12 text-center shadow-2xl transition-all duration-300">
                <div class="max-w-md mx-auto space-y-6">
                    <div class="w-28 h-28 sm:w-36 sm:h-36 mx-auto bg-green-100 rounded-full flex items-center justify-center shadow-inner text-5xl sm:text-6xl border-4 border-green-300">
                        🎬
                    </div>
                    <div class="space-y-3">
                        <h2 class="text-2xl sm:text-3xl font-black text-slate-800">
                            🎤 성실 인터뷰 쇼에 <br class="sm:hidden">오신 것을 환영합니다!
                        </h2>
                        <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-semibold bg-slate-100 p-4 rounded-2xl">
                            우리 모둠에서 한 명은 <strong class="text-emerald-600">주인공</strong>이 되고,<br>
                            나머지 친구들은 <strong class="text-blue-600">기자</strong>가 되어 인터뷰를 진행해 볼 거예요.
                        </p>
                    </div>

                    <button onclick="goToStep(1)" class="btn-bounce w-full py-4 sm:py-5 px-8 bg-gradient-to-r from-green-400 to-emerald-500 hover:from-green-500 hover:to-emerald-600 text-white font-extrabold text-xl sm:text-2xl rounded-2xl shadow-lg flex items-center justify-center gap-3 cursor-pointer">
                        <i class="fa-solid fa-users text-2xl"></i>
                        <span>모둠 역할 정하러 가기</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </section>

            <!-- STEP 1: Group Info -->
            <section id="step-1" class="glass-card rounded-3xl p-5 sm:p-8 shadow-2xl hidden transition-all duration-300">
                <div class="flex items-center justify-between border-b-2 border-slate-200 pb-4 mb-6">
                    <h2 class="text-xl sm:text-2xl font-black text-emerald-700 flex items-center gap-2">
                        <span class="bg-emerald-500 text-white w-8 h-8 rounded-full inline-flex items-center justify-center text-base">1</span>
                        우리 모둠원 이름 적기
                    </h2>
                    <span class="text-xs sm:text-sm font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full">1 / 3 단계</span>
                </div>

                <form id="group-form" onsubmit="handleGroupSubmit(event)" class="space-y-6">
                    <div>
                        <label class="block text-slate-800 font-bold text-base sm:text-lg mb-2">
                            🏷️ 모둠 이름 <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="group-name" required placeholder="예: 반짝반짝 1모둠" oninput="validateGroupForm()"
                            class="w-full px-4 py-3.5 rounded-2xl border-2 border-green-200 focus:border-green-500 focus:ring-4 focus:ring-green-100 outline-none font-bold text-lg">
                    </div>

                    <div>
                        <label class="block text-slate-800 font-bold text-base sm:text-lg mb-2">
                            👥 모둠원은 몇 명인가요?
                        </label>
                        <div class="grid grid-cols-2 gap-3 sm:gap-4">
                            <button type="button" onclick="setMemberCount(3)" id="btn-count-3" 
                                class="py-3 px-4 rounded-2xl font-extrabold text-lg border-2 transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-user-group"></i> 3명
                            </button>
                            <button type="button" onclick="setMemberCount(4)" id="btn-count-4" 
                                class="py-3 px-4 rounded-2xl font-extrabold text-lg border-2 transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-users"></i> 4명
                            </button>
                        </div>
                    </div>

                    <div id="members-container" class="space-y-3">
                        <!-- Dynamic member inputs -->
                    </div>

                    <div class="flex gap-3 pt-4 border-t-2 border-slate-100 mt-6">
                        <button type="button" onclick="goToStep(0)" class="w-1/3 py-4 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-lg rounded-2xl transition">이전</button>
                        <button type="submit" id="btn-step1-next" disabled 
                            class="btn-bounce w-2/3 py-4 bg-slate-300 text-slate-500 font-extrabold text-xl rounded-2xl shadow-lg flex items-center justify-center gap-2 cursor-not-allowed transition-all">
                            <span>다음 단계로</span> <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </section>

            <!-- STEP 2: Role & Situation Selection -->
            <section id="step-2" class="glass-card rounded-3xl p-5 sm:p-8 shadow-2xl hidden transition-all duration-300">
                <div class="flex items-center justify-between border-b-2 border-slate-200 pb-4 mb-4">
                    <h2 class="text-xl sm:text-2xl font-black text-blue-700 flex items-center gap-2">
                        <span class="bg-blue-500 text-white w-8 h-8 rounded-full inline-flex items-center justify-center text-base">2</span>
                        주인공과 상황 고르기
                    </h2>
                    <span class="text-xs sm:text-sm font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full">2 / 3 단계</span>
                </div>

                <form id="situation-form" onsubmit="handleSituationSubmit(event)" class="space-y-6">
                    <!-- Protagonist Selection -->
                    <div class="bg-blue-50 p-4 sm:p-5 rounded-2xl border border-blue-100">
                        <label class="block text-slate-800 font-extrabold text-lg mb-3">
                            👑 이번 역할극의 <span class="text-blue-600">주인공</span>은 누구인가요?
                        </label>
                        <p class="text-sm font-semibold text-slate-500 mb-3">선택되지 않은 친구들은 멋진 기자가 됩니다!</p>
                        <div id="protagonist-options" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- Situation Cards -->
                    <div>
                        <label class="block text-slate-800 font-extrabold text-lg mb-3">
                            🎯 인터뷰할 <span class="text-emerald-600">상황 카드</span>를 하나 골라주세요.
                        </label>
                        <div id="situation-cards" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <div class="flex gap-3 pt-4 border-t-2 border-slate-100">
                        <button type="button" onclick="goToStep(1)" class="w-1/3 py-4 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-lg rounded-2xl transition">이전</button>
                        <button type="submit" id="btn-step2-next" disabled
                            class="btn-bounce w-2/3 py-4 bg-slate-300 text-slate-500 font-extrabold text-xl rounded-2xl shadow-lg flex items-center justify-center gap-2 cursor-not-allowed transition-all">
                            <span>질문 고르기</span> <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </section>

            <!-- STEP 3: Question Selection -->
            <section id="step-3" class="glass-card rounded-3xl p-5 sm:p-8 shadow-2xl hidden transition-all duration-300">
                <div class="flex items-center justify-between border-b-2 border-slate-200 pb-4 mb-4">
                    <h2 class="text-xl sm:text-2xl font-black text-purple-700 flex items-center gap-2">
                        <span class="bg-purple-500 text-white w-8 h-8 rounded-full inline-flex items-center justify-center text-base">3</span>
                        기자 질문 고르기
                    </h2>
                    <span class="text-xs sm:text-sm font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full">3 / 3 단계</span>
                </div>

                <div class="bg-purple-50 p-4 rounded-2xl border border-purple-100 mb-6 flex gap-4 items-center">
                    <div class="text-4xl">🤔</div>
                    <div>
                        <p class="font-extrabold text-purple-900">주인공에게 물어볼 <span class="text-pink-600 text-lg">질문을 딱 2개만</span> 골라주세요.</p>
                        <p class="text-sm font-bold text-slate-600">마지막 질문("친구들에게 해주고 싶은 말")은 자동으로 추가됩니다!</p>
                    </div>
                </div>

                <form id="questions-form" onsubmit="handleQuestionsSubmit(event)" class="space-y-4">
                    <div id="questions-container" class="grid gap-3">
                        <!-- Populated by JS -->
                    </div>

                    <div class="flex gap-3 pt-6 border-t-2 border-slate-100">
                        <button type="button" onclick="goToStep(2)" class="w-1/3 py-4 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-lg rounded-2xl transition">이전</button>
                        <button type="submit" id="btn-step3-next" disabled
                            class="btn-bounce w-2/3 py-4 bg-slate-300 text-slate-500 font-extrabold text-xl rounded-2xl shadow-lg flex items-center justify-center gap-2 cursor-not-allowed transition-all">
                            <span>대본 뚝딱 만들기</span> ✨
                        </button>
                    </div>
                </form>
            </section>

            <!-- STEP Loading -->
            <section id="step-loading" class="glass-card rounded-3xl p-10 text-center shadow-2xl hidden my-auto">
                <div class="space-y-6 max-w-sm mx-auto py-8">
                    <div class="relative w-28 h-28 mx-auto">
                        <div class="absolute inset-0 rounded-full border-8 border-green-200 animate-ping opacity-75"></div>
                        <div class="relative rounded-full border-8 border-emerald-500 border-t-transparent animate-spin w-full h-full flex items-center justify-center text-4xl">
                            ✍️
                        </div>
                    </div>
                    <div>
                        <h3 class="text-2xl font-black text-slate-800 mb-2">
                            인터뷰 대본 작성 중...
                        </h3>
                        <p class="text-slate-600 font-bold text-sm animate-pulse">
                            우리 모둠원들의 이름으로 재미있는 상황극을 만들고 있어요! 🎭
                        </p>
                    </div>
                    <div class="w-full bg-slate-200 h-3 rounded-full overflow-hidden">
                        <div id="loading-bar" class="bg-gradient-to-r from-green-400 to-blue-500 h-full w-0 transition-all duration-300"></div>
                    </div>
                </div>
            </section>

            <!-- STEP 4: Final Script & Activity Sheet -->
            <section id="step-4" class="hidden space-y-6">
                <div class="no-print glass-card rounded-3xl p-6 text-center shadow-xl border-4 border-emerald-300 bg-emerald-50/90 space-y-4">
                    <span class="inline-block px-4 py-1 bg-emerald-500 text-white font-black text-sm rounded-full">대본 완성! 🎉</span>
                    <h2 class="text-2xl sm:text-4xl font-black text-emerald-900 font-gaegu">
                        🎤 성실 인터뷰 쇼 준비 완료!
                    </h2>
                    <div class="flex flex-wrap justify-center gap-2 text-sm sm:text-base font-bold text-slate-700">
                        <span class="bg-white px-3 py-1 rounded-xl shadow-sm border border-slate-200">👑 주인공: <span id="final-protagonist" class="text-blue-600"></span></span>
                        <span class="bg-white px-3 py-1 rounded-xl shadow-sm border border-slate-200">📝 기자: <span id="final-reporters" class="text-emerald-600"></span></span>
                    </div>
                    
                    <!-- Action Bar -->
                    <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
                        <button onclick="restartApp()" class="btn-bounce px-5 py-3 bg-slate-700 hover:bg-slate-800 text-white font-bold text-base rounded-2xl shadow-md flex items-center gap-2">
                            <i class="fa-solid fa-rotate-left"></i> <span>처음부터 다시</span>
                        </button>
                        <button onclick="window.print()" class="btn-bounce px-6 py-3 bg-gradient-to-r from-amber-400 to-orange-500 text-white font-extrabold text-base rounded-2xl shadow-md flex items-center gap-2">
                            <i class="fa-solid fa-print text-lg"></i> <span>대본 인쇄 🖨️</span>
                        </button>
                    </div>
                </div>

                <!-- Final Active Script Box -->
                <div id="final-script-box" class="script-card-print glass-card rounded-3xl p-6 sm:p-10 shadow-2xl space-y-6">
                    <!-- Script Content injected by JS -->
                </div>
            </section>

        </main>

        <footer class="no-print text-center text-xs sm:text-sm font-bold text-slate-500 py-4">
            🌱 초등학교 3학년 도덕 수업용 • 성실한 삶 인터뷰 생성기
        </footer>
    </div>

    <script>
        // Data Structures
        const SITUATIONS = [
            { id: 1, icon: "🏃", title: "새벽마다 연습하는 운동선수", desc: "매일 아침 6시에 일어나 비가 오나 피곤하나 연습하는 육상선수" },
            { id: 2, icon: "📚", title: "매일 책을 읽는 학생", desc: "처음엔 재미없었지만 매일 밤 20분씩 8개월째 책을 읽는 학생" },
            { id: 3, icon: "🎻", title: "악기를 꾸준히 연습하는 친구", desc: "어려워도 포기하지 않고 매일 30분씩 바이올린을 연습하는 친구" },
            { id: 4, icon: "🏫", title: "30년 동안 학교를 지킨 경비원", desc: "학생들의 안전을 위해 비가 오나 눈이 오나 매일 학교를 살피는 경비원 선생님" },
            { id: 5, icon: "🍱", title: "매일 도시락을 만드는 부모님", desc: "피곤해도 가족을 위해 새벽부터 일어나 기쁜 마음으로 도시락을 싸주시는 부모님" }
        ];

        const QUESTIONS = [
            "힘든데도 계속하는 이유는 무엇인가요?",
            "언제 가장 포기하고 싶었나요?",
            "그때 어떻게 이겨 냈나요?",
            "성실하게 생활하면서 가장 달라진 점은 무엇인가요?",
            "가장 기억에 남는 순간은 언제였나요?",
            "성실하려면 어떤 마음이 필요할까요?",
            "지금까지 계속할 수 있었던 비결은 무엇인가요?"
        ];
        const FIXED_QUESTION = "친구들에게 꼭 해 주고 싶은 말이 있나요?";

        // App State
        let state = {
            groupName: '',
            memberCount: 3,
            members: ['', '', '', ''],
            protagonistIndex: null,
            situationId: null,
            selectedQuestions: []
        };
        let finalScriptData = null;

        window.addEventListener('DOMContentLoaded', () => {
            setMemberCount(3);
        });

        function goToStep(step) {
            [0, 1, 2, 3, 'loading', 4].forEach(s => {
                const el = document.getElementById(`step-${s}`);
                if (el) el.classList.add('hidden');
            });
            const target = document.getElementById(`step-${step}`);
            if (target) target.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });

            if (step === 2) renderStep2();
            if (step === 3) renderStep3();
        }

        function setMemberCount(count) {
            state.memberCount = count;
            const btn3 = document.getElementById('btn-count-3');
            const btn4 = document.getElementById('btn-count-4');

            if (count === 3) {
                btn3.className = "py-3 px-4 rounded-2xl font-extrabold text-lg border-2 border-emerald-400 bg-emerald-500 text-white shadow-md transition-all flex items-center justify-center gap-2";
                btn4.className = "py-3 px-4 rounded-2xl font-extrabold text-lg border-2 border-emerald-200 bg-white text-emerald-600 hover:bg-emerald-50 shadow-sm transition-all flex items-center justify-center gap-2";
            } else {
                btn4.className = "py-3 px-4 rounded-2xl font-extrabold text-lg border-2 border-emerald-400 bg-emerald-500 text-white shadow-md transition-all flex items-center justify-center gap-2";
                btn3.className = "py-3 px-4 rounded-2xl font-extrabold text-lg border-2 border-emerald-200 bg-white text-emerald-600 hover:bg-emerald-50 shadow-sm transition-all flex items-center justify-center gap-2";
            }

            renderMemberInputs();
            validateGroupForm();
        }

        function renderMemberInputs() {
            const container = document.getElementById('members-container');
            container.innerHTML = '';

            for (let i = 0; i < state.memberCount; i++) {
                const row = document.createElement('div');
                row.className = "flex items-center gap-3";
                row.innerHTML = `
                    <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 font-black flex items-center justify-center flex-shrink-0">
                        ${i + 1}
                    </div>
                    <input type="text" id="member-name-${i}" required placeholder="모둠원 이름 (예: 지민)" value="${state.members[i] || ''}" oninput="updateMemberName(${i})"
                        class="w-full px-4 py-3 rounded-2xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none text-slate-800 font-bold text-base bg-white/90">
                `;
                container.appendChild(row);
            }
        }

        function updateMemberName(index) {
            const val = document.getElementById(`member-name-${index}`).value.trim();
            state.members[index] = val;
            validateGroupForm();
        }

        function validateGroupForm() {
            const gName = document.getElementById('group-name')?.value.trim();
            let allValid = Boolean(gName);

            for (let i = 0; i < state.memberCount; i++) {
                if (!state.members[i]) {
                    allValid = false;
                    break;
                }
            }

            const btnNext = document.getElementById('btn-step1-next');
