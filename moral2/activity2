            box.innerHTML = `
                <div class="border-b-2 border-slate-200 pb-4 mb-6 text-center">
                    <div class="text-4xl mb-2">${finalScriptData.icon}</div>
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-800">
                        상황: ${finalScriptData.title}
                    </h3>
                </div>

                <div class="space-y-4">
                    ${finalScriptData.dialogues.map((d, i) => {
                        const isProtagonist = d.speaker.includes('주인공');
                        const bgClass = isProtagonist ? 'bg-blue-50 border-blue-200' : 'bg-emerald-50 border-emerald-200';
                        const textClass = isProtagonist ? 'text-blue-800' : 'text-emerald-800';
                        const icon = isProtagonist ? '👑' : '🎤';
                        
                        return `
                            <div class="flex flex-col sm:flex-row items-start gap-2 sm:gap-4 p-4 rounded-2xl border-2 ${bgClass} shadow-sm print:border-solid print:border-gray-400 print:bg-white print:shadow-none">
                                <div class="flex-shrink-0 w-auto sm:w-28 text-left sm:text-right pt-1">
                                    <span class="inline-block px-3 py-1 bg-white rounded-lg border shadow-sm font-extrabold text-sm ${textClass}">
                                        ${icon} ${d.speaker}
                                    </span>
                                </div>
                                <div class="flex-grow">
                                    <div class="text-xs font-bold text-slate-500 mb-1">(${d.action})</div>
                                    <div class="text-base sm:text-lg font-bold text-slate-800 leading-relaxed">
                                        "${d.line}"
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: ['#4ade80', '#3b82f6', '#facc15', '#f472b6']
                });
            }
        }

        function restartApp() {
            state = {
                groupName: '',
                memberCount: 3,
                members: ['', '', '', ''],
                protagonistIndex: null,
                situationId: null,
                selectedQuestions: []
            };
            document.getElementById('group-form').reset();
            setMemberCount(3);
            goToStep(1);
        }
    </script>
</body>
</html>
