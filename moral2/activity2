            if(sit.id === 4) { proIntroTask = "우리 학교를 30년 동안 안전하게 지키는 일을"; proIntroAction = "든든한 표정으로"; }
            if(sit.id === 5) { proIntroTask = "매일 새벽 가족을 위해 도시락 싸는 일을"; proIntroAction = "따뜻한 미소를 지으며"; }

            dialogues.push({ speaker: `주인공(${pro})`, action: proIntroAction, line: `안녕하세요. 저는 ${pro}입니다. 저는 ${proIntroTask} 꾸준히 하고 있습니다.` });

