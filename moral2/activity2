                    else if (sit.id === 2) answer = "매일 새로운 이야기를 알게 되는 즐거움이 커서 계속 읽게 되었어요.";
                    else if (sit.id === 3) answer = "제가 연주하는 아름다운 소리를 들으면 기분이 좋아져서 멈출 수가 없어요.";
                    else if (sit.id === 4) answer = "우리 학생들이 매일 아침 밝게 웃으며 안전하게 등교하는 모습을 보면 정말 뿌듯하거든요.";
