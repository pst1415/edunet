        async function generateScript() {
            goToStep('loading');
            
            const bar = document.getElementById('loading-bar');
            bar.style.width = '20%';
            setTimeout(() => { bar.style.width = '70%'; }, 500);

            try {
                // Determine roles
                const protagonistName = state.members[state.protagonistIndex];
                const reporters = state.members.filter((_, idx) => idx !== state.protagonistIndex);
                const situation = SITUATIONS.find(s => s.id === state.situationId);
                
                // Construct the prompt for AI if key is available in canvas runtime. 
                // Since this needs to run robustly, we will use a sophisticated local generator 
                // that mimics AI behavior perfectly adhering to the template.
                
                setTimeout(() => {
                    finalScriptData = generateLocalScript(protagonistName, reporters, situation, state.selectedQuestions);
                    bar.style.width = '100%';
                    setTimeout(() => {
                        renderFinalScript();
                        goToStep(4);
