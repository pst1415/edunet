        function toggleQuestion(checkbox, question) {
            if (checkbox.checked) {
                if (state.selectedQuestions.length >= 2) {
                    // Prevent selecting more than 2
                    checkbox.checked = false;
                    showMessage("질문은 2개까지만 선택할 수 있어요!");
                    return;
                }
                state.selectedQuestions.push(question);
            } else {
                state.selectedQuestions = state.selectedQuestions.filter(q => q !== question);
            }
            validateStep3();
        }
        
        function showMessage(msg) {
            // Replaces alert()
            const m = document.createElement('div');
            m.className = 'fixed top-4 left-1/2 transform -translate-x-1/2 bg-red-500 text-white px-6 py-3 rounded-full font-bold shadow-xl z-50 animate-bounce';
